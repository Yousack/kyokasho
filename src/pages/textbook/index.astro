---
import { getCollection } from "astro:content";
import TextbookLayout from "../../layouts/TextbookLayout.astro";

const entries = (await getCollection(
  "textbook",
  ({ id }) => !id.endsWith("AGENTS"),
)).sort((a, b) => a.id.localeCompare(b.id, "ja"));

const titleOf = (entry: (typeof entries)[number]) =>
  entry.body?.match(/^#\s+(.+)$/m)?.[1] ??
  entry.id.split("/").at(-1) ??
  entry.id;

const hrefOf = (id: string) =>
  import.meta.env.BASE_URL +
  "textbook/" +
  id.split("/").map(encodeURIComponent).join("/") +
  "/";

const chapterEntries = (prefix: string) => entries.filter((entry) => {
  if (!entry.id.startsWith(prefix)) return false;
  const relativeId = entry.id.slice(prefix.length);
  return /^第\d+章 [^/]+$/.test(relativeId);
});

const linearAlgebraPart1Chapters = chapterEntries(
  "線形代数/第I部 ベクトルと線形変換/",
);
const linearAlgebraPart2Chapters = chapterEntries(
  "線形代数/第II部 連立一次方程式と部分空間/",
);
---

<TextbookLayout title="Markdown版 教科書">
  <h1>Markdown版 教科書</h1>
  <p class="lead">
    リポジトリ内の原稿をそのまま公開しています。数式はKaTeXで組版されます。
  </p>

  <h2>線形代数</h2>
  <h3>第I部 ベクトルと線形変換</h3>
  <ul class="chapter-list">
    {linearAlgebraPart1Chapters.map((entry) => (
      <li><a href={hrefOf(entry.id)}>{titleOf(entry)}</a></li>
    ))}
  </ul>
  <h3>第II部 連立一次方程式と部分空間</h3>
  <ul class="chapter-list">
    {linearAlgebraPart2Chapters.map((entry) => (
      <li><a href={hrefOf(entry.id)}>{titleOf(entry)}</a></li>
    ))}
  </ul>
</TextbookLayout>
