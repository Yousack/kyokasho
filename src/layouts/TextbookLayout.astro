---
import "katex/dist/katex.min.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "操作しながら概念を理解する、Web-firstの数学教科書" } = Astro.props;
const home = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" href={home + "favicon.svg"} />
  </head>
  <body>
    <header class="site-header">
      <a href={home}>インタラクティブ教科書</a>
      <span>読むだけでなく、動かして考える</span>
    </header>
    <main><slot /></main>
    <footer>本文と実験を往復しながら学ぶ数学教科書</footer>
  </body>
</html>

<style is:global>
  :root { color-scheme: light; --ink: #16211d; --muted: #5e6b65; --paper: #f8f6ef; --panel: #fffdf7; --accent: #096b58; --line: #cbd6d0; font-family: "Hiragino Sans", "Yu Gothic", system-ui, sans-serif; background: var(--paper); color: var(--ink); }
  * { box-sizing: border-box; }
  body { margin: 0; line-height: 1.8; }
  .site-header, main, footer { width: min(920px, calc(100% - 32px)); margin-inline: auto; }
  .site-header { display: flex; justify-content: space-between; gap: 1rem; align-items: baseline; padding: 1.2rem 0; border-bottom: 1px solid var(--line); }
  .site-header a { color: var(--ink); font-weight: 800; text-decoration: none; }
  .site-header span, footer { color: var(--muted); font-size: .9rem; }
  main { padding: 3rem 0 5rem; }
  footer { border-top: 1px solid var(--line); padding: 1.5rem 0 3rem; }
  h1 { font-size: clamp(2.2rem, 7vw, 4.8rem); line-height: 1.08; letter-spacing: -.04em; max-width: 12ch; }
  h2 { margin-top: 3rem; line-height: 1.35; }
  p { max-width: 68ch; }
  blockquote { max-width: 68ch; margin: 1.6rem 0; padding: 1rem 1.2rem; border: 1px solid #9dbbb2; border-left: 5px solid var(--accent); border-radius: 10px; background: #f1f8f5; box-shadow: 0 2px 8px rgb(22 33 29 / 6%); }
  blockquote > :first-child { margin-top: 0; }
  blockquote > :last-child { margin-bottom: 0; }
  blockquote > p:first-child > strong:first-child { color: var(--accent); letter-spacing: .02em; }
  main img { display: block; max-width: 100%; height: auto; }
  a { color: var(--accent); }
  .lead { font-size: 1.2rem; color: var(--muted); max-width: 55ch; }
  .chapter-list { display: grid; gap: 1rem; padding: 0; list-style: none; }
  .chapter-list a { display: block; background: var(--panel); border: 1px solid var(--line); border-radius: 14px; padding: 1rem 1.2rem; text-decoration: none; }
  @media (max-width: 600px) { .site-header { align-items: flex-start; flex-direction: column; } }
</style>
